{
  id: "core:schema.ui_field.tab_container.v1",
  schema_domain: "ui_field",
  schema_version: 1,
  root: {
    kind: "object",
    fields: {
      default_tab_key: {
        kind: "key",
        required: false,
      },
      tabs: {
        kind: "array",
        required: true,
        keyed_by: "key",
        items: {
          kind: "object",
          fields: {
            key: {
              kind: "key",
              required: true,
            },
            title: {
              kind: "text",
              required: true,
            },
            screen_id: {
              kind: "ref",
              target_kind: "screen",
              required: true,
            },
            fields: {
              kind: "screen_fields",
              required: false,
            },
          },
        },
      },
      key: {
        kind: "key",
        required: false,
      },
    },
  },
}
