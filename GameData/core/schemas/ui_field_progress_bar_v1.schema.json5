{
  id: "core:schema.ui_field.progress_bar.v1",
  schema_domain: "ui_field",
  schema_version: 1,
  root: {
    kind: "object",
    fields: {
      percent: {
        kind: "number",
        min: 0.0,
        max: 1.0,
        required: true,
      },
      label: {
        kind: "text",
        required: false,
      },
      key: {
        kind: "key",
        required: false,
      },
    },
  },
}
