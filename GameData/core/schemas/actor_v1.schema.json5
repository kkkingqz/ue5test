{
  // Framework actor schema (ADR-0026, CBM-12).
  // discriminator is the only framework requirement: runtime uses it
  // to select the disposable instance wrapper. Gameplay fields (base_hp,
  // name_text_id, etc.) belong to the gameplay package.
  id: "core:schema.definition.actor.v1",
  definition_type: "actor",
  schema_version: 1,
  root: {
    kind: "object",
    fields: {
      discriminator: {
        kind: "enum",
        required: true,
        values: ["player", "npc"],
      },
    },
  },
  semantic_validators: [],
  extensions: {},
}
