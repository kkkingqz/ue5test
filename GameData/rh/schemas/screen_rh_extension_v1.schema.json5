{
  id: "rh:schema.extension.screen.entry.v1",
  definition_type: "screen",
  schema_version: 1,
  extension_site: "definition_entry",
  extension_namespace: "rh",
  root: {
    kind: "object",
    fields: {
      background_resource_id: { kind: "resource_ref", resource_class: "texture_2d", required: true },
      characters: {
        kind: "array",
        required: false,
        items: {
          kind: "object",
          fields: {
            key: { kind: "string", required: true },
            resource_id: { kind: "resource_ref", resource_class: "texture_2d", required: true },
          },
        },
      },
    },
  },
}
