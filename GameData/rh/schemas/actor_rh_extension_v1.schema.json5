    kind: "object",
    fields: {
      name_text_id: {
        kind: "text_id",
        required: true,
      },
      base_hp: {
        kind: "int64",
        required: true,
        min: 1,
      },
      portrait_resource_id: {
        kind: "resource_ref",
        resource_class: "texture_2d",
        required: false,
      },
    },
  },
}
