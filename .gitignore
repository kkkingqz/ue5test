*.dll
*.dylib
*.exe
*.exp
*.ilk
*.lib
*.log
*.obj
*.pdb
*.so

# Standalone/CMake build trees
build/
cmake-build-*/

# Local Codex/agent configuration
.agents/
.codex/

# OS metadata
.DS_Store
Thumbs.db
