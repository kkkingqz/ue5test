{
  schema_version: 1,
  type: "text",
  definitions: [
    {
      id: "rh:text.location.rome.square.title",
      data: { source_message: "Вечный Рим" },
    },
    {
      id: "rh:text.location.rome.menhunter.title",
      data: { source_message: "Магазин Менхантера" },
    },
    {
      id: "rh:text.location.rome.butcher.title",
      data: { source_message: "Лавка мясника" },
    },
    {
      id: "rh:text.location.rome.market.title",
      data: { source_message: "Рынок" },
    },
    {
      id: "rh:text.location.fog.mists.title",
      data: { source_message: "Туманы" },
    },
    {
      id: "rh:text.location.woods.camp.title",
      data: { source_message: "Лагерь" },
    },
    // название леса на глубине; заменяет заголовок локации леса
    {
      id: "rh:text.woods.depth_0",
      data: { source_message: "Опушка леса" },
    },
    {
      id: "rh:text.woods.depth_1",
      data: { source_message: "Густой лес" },
    },
    {
      id: "rh:text.woods.depth_2",
      data: { source_message: "Лесная глушь" },
    },
    // en: было «Windfall / Deep Thicket»
    {
      id: "rh:text.woods.depth_3",
      data: { source_message: "Бурелом" },
    },
    {
      id: "rh:text.time_of_day.morning",
      data: { source_message: "утро" },
    },
    {
      id: "rh:text.time_of_day.day",
      data: { source_message: "день" },
    },
    {
      id: "rh:text.time_of_day.evening",
      data: { source_message: "вечер" },
    },
    {
      id: "rh:text.time_of_day.night",
      data: { source_message: "ночь" },
    },
    // показ вместо времени суток в Туманах
    {
      id: "rh:text.time_of_day.fog",
      data: { source_message: "в туманах царит безвременье" },
    },
    // ru дополнен до предложения, как en
    {
      id: "rh:text.hunger.fed",
      data: { source_message: "Вы сыты." },
    },
    {
      id: "rh:text.hunger.hungry",
      data: { source_message: "Вы проголодались." },
    },
    {
      id: "rh:text.hunger.very_hungry",
      data: { source_message: "Вы очень голодны." },
    },
    {
      id: "rh:text.hunger.famished",
      data: { source_message: "Вы истощены." },
    },
    {
      id: "rh:text.item.tool.blanket.title",
      data: { source_message: "Одеяло" },
    },
    {
      id: "rh:text.item.tool.shackles.title",
