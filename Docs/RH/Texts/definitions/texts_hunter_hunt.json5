{
  schema_version: 1,
  type: "text",
  definitions: [
    // сцена выбирается случайно; своя картинка
    {
      id: "rh:text.hunt.scene.drink",
      data: { source_message: "Вы выглядываете из-за кустов и видите небольшое озерцо. На его берегу, спиной к вам стоит на четвереньках дикарка. Она лакает воду, словно дикий зверь." },
    },
    {
      id: "rh:text.hunt.scene.s1",
      data: { source_message: "Вы осторожно приближаетесь к источнику шума и выглядываете из-за дерева. Впереди видна небольшая поляна, покрытая сочной, мягкой травой. Прямо посреди поляны лежит на спине дикарка. У вас есть хорошая возможность показать ей, что в лесу надо вести себя осторожнее." },
    },
    {
      id: "rh:text.hunt.scene.s2",
      data: { source_message: "Выглянув из-за кустов, вы замечаете дикарку, которая сидит под деревом. Ее ноги широко разведены в стороны. Похоже, она совсем забыла об осторожности." },
    },
    {
      id: "rh:text.hunt.scene.sleep",
      data: { source_message: "Вы осторожно приближаетесь к источнику шума и выглядываете из-за дерева. В нескольких метрах перед вами на мягкой постели изо мха спит, свернувшись калачиком, дикарка. Отличный шанс для атаки!" },
    },
    {
      id: "rh:text.hunt.scene.apple",
      data: { source_message: "Выглянув из-за кустов вы замечаете дикарку, которая стоит боком к вам, у плодового дерева. Похоже, она хочет достать яблоко с ветки, но ей не удается туда допрыгнуть. Глупышка так увлеклась процессом, что совсем вас не замечает." },
    },
    {
      id: "rh:text.hunt.scene.waterfall",
      data: { source_message: "Впереди слышен шум водопада и женский голос, напевающий что-то без слов. Вы подкрадываетесь и осторожно выглядываете из-за покрытого мхом валуна. Прямо под струями водопада стоит дикарка. У вас есть шанс доказать ей, что она подобрала не лучший момент для освежающего душа." },
    },
    {
      id: "rh:text.hunt.scene.hotspring",
      data: { source_message: "Впереди слышно странное бульканье. Подойдя поближе, вы понимаете, что наткнулись на горячий источник. Однако, вы не были первым кто его нашел. В круглом озерце, исходящем горячим паром, нежится дикарка. Ее тело расслаблено, а глаза закрыты. Отличный момент для внезапного нападения!" },
    },
    {
      id: "rh:text.hunt.scene.rabbit",
      data: { source_message: "Вы осторожно выглядываете из кустов. Неподалеку впереди под деревом расположилась дикарка. У нее на руках сидит большой пушистый кролик. Дикарка ласкает кролика и сюсюкает с ним. Похоже, она так увлеклась, что не замечает ничего вокруг." },
    },
    {
      id: "rh:text.hunt.scene.butterfly",
      data: { source_message: "Вы осторожно выглядываете из-за дерева. Впереди на небольшой, залитой солнцем полянке стоит на четвереньках дикарка. Похоже, она разглядывает огромную тропическую бабочку, усевшуюся на землю." },
    },
    {
      id: "rh:text.hunt.scene.splinter",
      data: { source_message: "Вы осторожно выглядываете из кустов. У корней огромного дерева сидит дикарка. Похоже, девушка пытается зубами достать занозу, засевшую у нее в ступне." },
    },
    {
      id: "rh:text.hunt.scene.s3",
      data: { source_message: "Вы осторожно выглядываете из кустов. Неподалеку от вас, прислонившись спиной к толстому дереву стоит дикарка." },
    },
    {
      id: "rh:text.hunt.scene.chase_butterfly",
      data: { source_message: "Вы приближаетесь к источнику звуков и аккуратно выглядываете из-за дерева. Впереди видна небольшая, открытая лужайка. Там, бегая по кругу, гоняется за большой цветастой бабочкой дикарка. Похоже, она так увлеклась процессом, что не замечает ничего вокруг." },
    },
  ],
}
